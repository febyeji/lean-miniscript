import LeanMiniscript.Bitcoin.SHA1

namespace LeanMiniscript.Bitcoin.SHA1

/-! Independent SHA-1 byte vectors generated with Python hashlib/OpenSSL.
Inputs cross both padding and block boundaries and include a maximum Script
push. The standard "abc" vector is also exercised through OP_SHA1 execution. -/

private def boundaryVectors : List (Nat × ByteArray) :=
  [(0, ⟨#[0xda,0x39,0xa3,0xee,0x5e,0x6b,0x4b,0x0d,0x32,0x55,0xbf,0xef,0x95,0x60,0x18,0x90,0xaf,0xd8,0x07,0x09]⟩),
   (55, ⟨#[0x8a,0xe2,0xd4,0x67,0x29,0xcf,0xe6,0x8f,0xf9,0x27,0xaf,0x5e,0xec,0x9c,0x7d,0x1b,0x66,0xd6,0x5a,0xc2]⟩),
   (56, ⟨#[0x63,0x6e,0x2e,0xc6,0x98,0xda,0xc9,0x03,0x49,0x8e,0x64,0x8b,0xd2,0xf3,0xaf,0x64,0x1d,0x3c,0x88,0xcb]⟩),
   (63, ⟨#[0x6d,0x94,0x2d,0xa0,0xc4,0x39,0x2b,0x12,0x35,0x28,0xf2,0x90,0x5c,0x71,0x3a,0x3c,0xe2,0x83,0x64,0xbd]⟩),
   (64, ⟨#[0xc6,0x13,0x8d,0x51,0x4f,0xfa,0x21,0x35,0xbf,0xce,0x0e,0xd0,0xb8,0xfa,0xc6,0x56,0x69,0x91,0x7e,0xc7]⟩),
   (65, ⟨#[0x69,0xbd,0x72,0x8a,0xd6,0xe1,0x3c,0xd7,0x6f,0xf1,0x97,0x51,0xfd,0xe4,0x27,0xb0,0x0e,0x39,0x57,0x46]⟩),
   (520, ⟨#[0xf4,0x7b,0x91,0xa7,0x14,0x0e,0x31,0x4b,0xdd,0xc7,0x9f,0xfa,0x94,0x1a,0xf1,0x48,0x23,0x9f,0xb9,0x15]⟩)]

example : boundaryVectors.all (fun (size, expected) =>
    hash ⟨((List.range size).map UInt8.ofNat).toArray⟩ == expected) = true := by
  native_decide

-- FIPS 180's multi-block alphabetic message (56 bytes) exercises length padding.
example : hash "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".toUTF8 =
    ⟨#[0x84,0x98,0x3e,0x44,0x1c,0x3b,0xd2,0x6e,0xba,0xae,
      0x4a,0xa1,0xf9,0x51,0x29,0xe5,0xe5,0x46,0x70,0xf1]⟩ := by native_decide

end LeanMiniscript.Bitcoin.SHA1
