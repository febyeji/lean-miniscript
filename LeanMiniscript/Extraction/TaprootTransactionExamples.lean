private def flip (bytes : ByteArray) (index : Nat) : ByteArray :=
  ⟨bytes.data.set! index (bytes[index]! ^^^ 1)⟩

private def verifyKeyPath (fixture : KeyPathFixture) (witness : List ByteArray)
    (transaction : Transaction := sighashFixtureTransaction)
    (spentOutputs : Array TxOutput := sighashFixtureSpentOutputs)
    (scriptPubKey : ByteArray := sighashFixtureSpentOutputs[fixture.inputIndex]!.scriptPubKey) :
    Except CoreVerificationError Unit :=
  verifyNativeTaprootTransaction CryptoOracle.pureLeanSchnorr taprootFlags transaction
    spentOutputs fixture.inputIndex ByteArray.empty scriptPubKey witness

