import LeanMiniscript.Properties.SatisfactionResourceAtomicProofs
import LeanMiniscript.Properties.SatisfactionResourceConnectorProofs
import LeanMiniscript.Properties.SatisfactionResourceGuardProofs
import LeanMiniscript.Properties.SatisfactionResourceMultiProofs
import LeanMiniscript.Properties.SatisfactionResourceThresholdProofs

namespace LeanMiniscript.Properties

open LeanMiniscript.Miniscript
open LeanMiniscript.Script

/-!
# Recursive generated-satisfaction contract

The constructor-local contracts compose by mutual recursion over `HasType` and
`HasTypeList`. The list theorem keeps threshold children and their candidate
pairs aligned in source order.
-/

mutual

/-- Every well-formed, well-typed core fragment has the strong contract for
    every usable witness generated by `satisfactionCandidates`. -/
theorem supportsGeneratedResources_of_wellFormed_hasType
    {scriptCtx : ScriptContext} {fragment : CoreFragment} {ty : MiniType}
    {env : SatEnv} {flags : ScriptFlags}
    (version : ModeledContextVersion scriptCtx env.txCtx)
    (modeled : ModeledContextFlags scriptCtx flags)
    (sound : env.Sound) (encodings : env.EncodingSound flags)
    (typed : HasType scriptCtx fragment ty)
    (wellFormed : CoreFragment.WellFormed scriptCtx fragment) :
    CandidatePair.SupportsGeneratedResources
      (satisfactionCandidates fragment env) scriptCtx fragment ty flags
      env.txCtx := by
  cases typed with
  | zero => exact generatedResources_zero scriptCtx env flags
  | one => exact generatedResources_one scriptCtx env flags
  | pk_k key =>
      exact generatedResources_pk_k wellFormed version modeled sound
        encodings
  | pk_h key =>
      exact generatedResources_pk_h wellFormed version modeled sound
        encodings
  | older n => exact generatedResources_older wellFormed
  | after n => exact generatedResources_after wellFormed
  | sha256 hash =>
      simpa [HashLock.fragment, satisfactionCandidates] using
        (generatedResources_hash (scriptCtx := scriptCtx)
          (lock := HashLock.sha256 hash) (env := env) (flags := flags) sound)
  | hash256 hash =>
      simpa [HashLock.fragment, satisfactionCandidates] using
        (generatedResources_hash (scriptCtx := scriptCtx)
          (lock := HashLock.hash256 hash) (env := env) (flags := flags) sound)
  | ripemd160 hash =>
      simpa [HashLock.fragment, satisfactionCandidates] using
        (generatedResources_hash (scriptCtx := scriptCtx)
          (lock := HashLock.ripemd160 hash) (env := env) (flags := flags) sound)
  | hash160 hash =>
      simpa [HashLock.fragment, satisfactionCandidates] using
        (generatedResources_hash (scriptCtx := scriptCtx)
          (lock := HashLock.hash160 hash) (env := env) (flags := flags) sound)
  | @and_v first second firstMods secondType firstTyped secondTyped branch =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2.1
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.and_v firstSupported
          secondSupported branch)
  | @and_b first second firstMods secondMods firstTyped secondTyped =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2.1
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.and_b firstSupported secondSupported)
  | @or_b first second firstMods secondMods firstTyped firstD secondTyped secondD =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.or_b firstSupported firstD
          secondSupported secondD)
  | @or_c first second firstMods secondMods firstTyped firstD firstUnit secondTyped =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.or_c firstSupported firstD
          firstUnit secondSupported)
  | @or_d first second firstMods secondMods firstTyped firstD firstUnit secondTyped =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.or_d firstSupported firstD
          firstUnit secondSupported)
  | @or_i first second firstType secondType firstTyped secondTyped branch baseEq =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2
      cases firstType with
      | mk firstBase firstMods =>
          cases secondType with
          | mk secondBase secondMods =>
              change firstBase = secondBase at baseEq
              subst secondBase
              simpa [satisfactionCandidates] using
                (CandidatePair.SupportsGeneratedResources.or_i firstSupported
                  secondSupported branch)
  | @andor first second third firstMods secondType thirdType firstTyped firstD
      firstUnit secondTyped thirdTyped branch baseEq =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2.1
      have thirdSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings thirdTyped wellFormed.2.2.1
      cases secondType with
      | mk secondBase secondMods =>
          cases thirdType with
          | mk thirdBase thirdMods =>
              change secondBase = thirdBase at baseEq
              subst thirdBase
              simpa [satisfactionCandidates] using
                (CandidatePair.SupportsGeneratedResources.andor firstSupported
                  firstD firstUnit secondSupported thirdSupported branch)
  | @c_wrap child mods childTyped =>
      have childSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.c childSupported)
  | @v_wrap child mods childTyped =>
      have childSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.v childSupported)
  | @a_wrap child mods childTyped =>
      have childSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.a childSupported)
  | @s_wrap child mods childTyped oneArg =>
      have childSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.s childSupported oneArg)
  | @d_wrap child mods childTyped zeroArg =>
      have childSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.d childSupported zeroArg)
  | @j_wrap child mods childTyped nonzero =>
      have childSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.j childSupported nonzero)
  | @n_wrap child mods childTyped =>
      have childSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedResources.n childSupported)
  | @thresh threshold first rest firstMods restTypes firstTyped firstD firstUnit
      restTyped restShape positive atMost =>
      have childrenWellFormed := wellFormed.2.1
      simp only [CoreFragment.allWellFormed] at childrenWellFormed
      have firstSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings firstTyped childrenWellFormed.1
      have restSupported :=
        supportsGeneratedResourcesList_of_allWellFormed_hasTypeList
          version modeled sound encodings restTyped childrenWellFormed.2
      by_cases valid : candidateThresholdValid threshold (first :: rest).length
      · exact generatedResources_thresh firstSupported firstD firstUnit restSupported
          restShape positive atMost valid.2.2
      · exact generatedResources_thresh_invalid
          (.thresh firstTyped firstD firstUnit restTyped restShape positive atMost)
          valid
  | multi threshold keys positive atMost =>
      exact generatedResources_multi wellFormed version modeled
        sound encodings
  | multi_a threshold keys positive atMost =>
      exact generatedResources_multiA wellFormed version modeled
        sound encodings

/-- Pointwise list counterpart of
    `supportsGeneratedResources_of_wellFormed_hasType`. -/
theorem supportsGeneratedResourcesList_of_allWellFormed_hasTypeList
    {scriptCtx : ScriptContext} {fragments : List CoreFragment}
    {types : List MiniType} {env : SatEnv} {flags : ScriptFlags}
    (version : ModeledContextVersion scriptCtx env.txCtx)
    (modeled : ModeledContextFlags scriptCtx flags)
    (sound : env.Sound) (encodings : env.EncodingSound flags)
    (typed : HasTypeList scriptCtx fragments types)
    (wellFormed : CoreFragment.allWellFormed scriptCtx fragments) :
    SupportsGeneratedResourcesList scriptCtx flags env.txCtx
      (satisfactionCandidatesList fragments env) fragments types := by
  cases typed with
  | nil => exact .nil
  | @cons fragment ty fragments types headTyped tailTyped =>
      simp only [CoreFragment.allWellFormed] at wellFormed
      have headSupported := supportsGeneratedResources_of_wellFormed_hasType
        version modeled sound encodings headTyped wellFormed.1
      have tailSupported :=
        supportsGeneratedResourcesList_of_allWellFormed_hasTypeList
          version modeled sound encodings tailTyped wellFormed.2
      simpa [satisfactionCandidatesList] using
        (SupportsGeneratedResourcesList.cons headSupported tailSupported)

end

end LeanMiniscript.Properties
