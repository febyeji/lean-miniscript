import LeanMiniscript.Properties.SatisfactionBudgetThresholdProofs

namespace LeanMiniscript.Properties

open LeanMiniscript.Miniscript
open LeanMiniscript.Script

/-!
# Recursive generated-satisfaction signature budget

The constructor-local contracts compose by mutual recursion over `HasType` and
`HasTypeList`. The list theorem keeps threshold children and their candidate
pairs aligned in source order.
-/

mutual

/-- Every well-formed, well-typed Tapscript fragment has a funded contract for
    every usable witness generated by `satisfactionCandidates`. -/
theorem supportsGeneratedBudgets_of_wellFormed_hasType
    {fragment : CoreFragment} {ty : MiniType}
    {env : SatEnv} {flags : ScriptFlags}
    (version : ModeledContextVersion .tapscript env.txCtx)
    (modeled : ModeledContextFlags .tapscript flags)
    (sound : env.Sound) (encodings : env.EncodingSound flags)
    (typed : HasType .tapscript fragment ty)
    (wellFormed : CoreFragment.WellFormed .tapscript fragment) :
    CandidatePair.SupportsGeneratedBudgets
      (satisfactionCandidates fragment env) .tapscript fragment ty flags
      env.txCtx := by
  cases typed with
  | zero => exact generatedBudgets_zero .tapscript env flags
  | one => exact generatedBudgets_one .tapscript env flags
  | pk_k key =>
      exact generatedBudgets_pk_k wellFormed version modeled sound
        encodings
  | pk_h key =>
      exact generatedBudgets_pk_h wellFormed version modeled sound
        encodings
  | older n => exact generatedBudgets_older wellFormed
  | after n => exact generatedBudgets_after wellFormed
  | sha256 hash =>
      simpa [HashLock.fragment, satisfactionCandidates] using
        (generatedBudgets_hash (scriptCtx := .tapscript)
          (lock := HashLock.sha256 hash) (env := env) (flags := flags) sound)
  | hash256 hash =>
      simpa [HashLock.fragment, satisfactionCandidates] using
        (generatedBudgets_hash (scriptCtx := .tapscript)
          (lock := HashLock.hash256 hash) (env := env) (flags := flags) sound)
  | ripemd160 hash =>
      simpa [HashLock.fragment, satisfactionCandidates] using
        (generatedBudgets_hash (scriptCtx := .tapscript)
          (lock := HashLock.ripemd160 hash) (env := env) (flags := flags) sound)
  | hash160 hash =>
      simpa [HashLock.fragment, satisfactionCandidates] using
        (generatedBudgets_hash (scriptCtx := .tapscript)
          (lock := HashLock.hash160 hash) (env := env) (flags := flags) sound)
  | @and_v first second firstMods secondType firstTyped secondTyped branch =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2.1
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.and_v firstSupported
          secondSupported branch)
  | @and_b first second firstMods secondMods firstTyped secondTyped =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2.1
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.and_b firstSupported secondSupported)
  | @or_b first second firstMods secondMods firstTyped firstD secondTyped secondD =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.or_b firstSupported firstD
          secondSupported secondD)
  | @or_c first second firstMods secondMods firstTyped firstD firstUnit secondTyped =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.or_c firstSupported firstD
          firstUnit secondSupported)
  | @or_d first second firstMods secondMods firstTyped firstD firstUnit secondTyped =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.or_d firstSupported firstD
          firstUnit secondSupported)
  | @or_i first second firstType secondType firstTyped secondTyped branch baseEq =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2
      cases firstType with
      | mk firstBase firstMods =>
          cases secondType with
          | mk secondBase secondMods =>
              change firstBase = secondBase at baseEq
              subst secondBase
              simpa [satisfactionCandidates] using
                (CandidatePair.SupportsGeneratedBudgets.or_i firstSupported
                  secondSupported branch)
  | @andor first second third firstMods secondType thirdType firstTyped firstD
      firstUnit secondTyped thirdTyped branch baseEq =>
      simp only [CoreFragment.WellFormed] at wellFormed
      have firstSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings firstTyped wellFormed.1
      have secondSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings secondTyped wellFormed.2.1
      have thirdSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings thirdTyped wellFormed.2.2.1
      cases secondType with
      | mk secondBase secondMods =>
          cases thirdType with
          | mk thirdBase thirdMods =>
              change secondBase = thirdBase at baseEq
              subst thirdBase
              simpa [satisfactionCandidates] using
                (CandidatePair.SupportsGeneratedBudgets.andor firstSupported
                  firstD firstUnit secondSupported thirdSupported branch)
  | @c_wrap child mods childTyped =>
      have childSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.c childSupported)
  | @v_wrap child mods childTyped =>
      have childSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.v childSupported)
  | @a_wrap child mods childTyped =>
      have childSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.a childSupported)
  | @s_wrap child mods childTyped oneArg =>
      have childSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.s childSupported oneArg)
  | @d_wrap child mods childTyped zeroArg =>
      have childSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.d childSupported zeroArg)
  | @j_wrap child mods childTyped nonzero =>
      have childSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.j childSupported nonzero)
  | @n_wrap child mods childTyped =>
      have childSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings childTyped wellFormed
      simpa [satisfactionCandidates] using
        (CandidatePair.SupportsGeneratedBudgets.n childSupported)
  | @thresh threshold first rest firstMods restTypes firstTyped firstD firstUnit
      restTyped restShape positive atMost =>
      have childrenWellFormed := wellFormed.2.1
      simp only [CoreFragment.allWellFormed] at childrenWellFormed
      have safe : ArithmeticScriptNatSafe threshold :=
        ArithmeticScriptNatSafe.of_lt (by
          simpa [MAX_BIP_ARITHMETIC_VALUE, MAX_BIP_LOCK_VALUE,
            maxArithmeticScriptNatExclusive] using
            wellFormed.2.2.2)
      have firstSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings firstTyped childrenWellFormed.1
      have restSupported :=
        supportsGeneratedBudgetsList_of_allWellFormed_hasTypeList
          version modeled sound encodings restTyped childrenWellFormed.2
      exact generatedBudgets_thresh firstSupported firstD firstUnit restSupported
        restShape positive atMost safe
  | multi threshold keys positive atMost =>
      simp [CoreFragment.WellFormed, ScriptContext.permitsLegacyMulti] at wellFormed
  | multi_a threshold keys positive atMost =>
      exact generatedBudgets_multiA wellFormed version modeled
        sound encodings

/-- Pointwise list counterpart of
    `supportsGeneratedBudgets_of_wellFormed_hasType`. -/
theorem supportsGeneratedBudgetsList_of_allWellFormed_hasTypeList
    {fragments : List CoreFragment}
    {types : List MiniType} {env : SatEnv} {flags : ScriptFlags}
    (version : ModeledContextVersion .tapscript env.txCtx)
    (modeled : ModeledContextFlags .tapscript flags)
    (sound : env.Sound) (encodings : env.EncodingSound flags)
    (typed : HasTypeList .tapscript fragments types)
    (wellFormed : CoreFragment.allWellFormed .tapscript fragments) :
    SupportsGeneratedBudgetsList .tapscript flags env.txCtx
      (satisfactionCandidatesList fragments env) fragments types := by
  cases typed with
  | nil => exact .nil
  | @cons fragment ty fragments types headTyped tailTyped =>
      simp only [CoreFragment.allWellFormed] at wellFormed
      have headSupported := supportsGeneratedBudgets_of_wellFormed_hasType
        version modeled sound encodings headTyped wellFormed.1
      have tailSupported :=
        supportsGeneratedBudgetsList_of_allWellFormed_hasTypeList
          version modeled sound encodings tailTyped wellFormed.2
      simpa [satisfactionCandidatesList] using
        (SupportsGeneratedBudgetsList.cons headSupported tailSupported)

end

end LeanMiniscript.Properties
